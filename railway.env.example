# Paste into Railway → SilverFox service → Variables → Raw Editor
# Replace CHANGE_ME with: python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# STEP 1: Add a PostgreSQL service in the same Railway project first.
# STEP 2: For DATABASE_URL, click "Add Variable Reference" and pick your Postgres → DATABASE_URL
#         OR paste: DATABASE_URL=${{Postgres.DATABASE_URL}}
#         (Use the exact Postgres service name shown in Railway if not "Postgres".)

DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False
DJANGO_ENABLE_ADMIN=true
DJANGO_SSL_REDIRECT=true

# Optional — Railway usually sets RAILWAY_PUBLIC_DOMAIN automatically after first deploy.
# Add your public hostname if CSRF fails on login/checkout:
# CSRF_TRUSTED_ORIGINS=https://silverfox-production.up.railway.app

# --- Linked from Postgres service (required) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Stripe (optional until checkout is wired) ---
# STRIPE_SECRET_KEY=sk_live_
# STRIPE_PUBLISHABLE_KEY=pk_live_
# STRIPE_WEBHOOK_SECRET=whsec_

