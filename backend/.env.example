# SilverFox Django backend — copy to .env (never commit .env)

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_ENABLE_ADMIN=true

# PostgreSQL on Railway/Render (omit for local SQLite)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Gmail SMTP
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DJANGO_DEFAULT_FROM_EMAIL=your@gmail.com
# CONTACT_RECIPIENT_EMAIL=your@gmail.com

# Optional AI chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Stripe (future)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
