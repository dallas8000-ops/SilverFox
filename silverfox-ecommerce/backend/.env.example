# SilverFox backend — copy to .env and fill in values (never commit .env)

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production

# Database (optional — defaults to backend/db.sqlite)
# DB_PATH=/path/to/db.sqlite

# Default staff login (created on startup if missing)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin

# CORS (Railway / custom domain)
# CORS_ORIGINS=https://your-app.up.railway.app

# Frontend dev redirect when React build missing
# FRONTEND_URL=http://localhost:5173

# --- Gmail SMTP (contact + order alerts) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_FROM=your@gmail.com
CONTACT_RECIPIENT_EMAIL=your@gmail.com
ORDER_ALERT_EMAIL=your@gmail.com

# --- Optional AI chat ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Optional mobile money (stub until wired) ---
# MTN_API_KEY=
# AIRTEL_API_KEY=
# MPESA_API_KEY=

# Disable open admin registration in production
# ALLOW_ADMIN_REGISTER=false
